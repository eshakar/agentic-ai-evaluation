# Copy to .env and fill in values. Never commit .env.
APP_NAME=agentic-ai-evaluation
APP_ENV=development
LOG_LEVEL=INFO
# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Anthropic (Claude) API
ANTHROPIC_API_KEY=sk-ant-...
# Model used by the agent under test
AGENT_MODEL=claude-opus-5-5
# Model used as the LLM judge
JUDGE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AGENT_EFFORT=medium
JUDGE_EFFORT=medium
# Retry refused requests on a fallback model automatically (server-side)
ENABLE_FALLBACKS=true

# Google Gemini API (used by the "gemini" agent and, if JUDGE_PROVIDER=gemini, by llm_judge)
GEMINI_API_KEY=your-gemini-key
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
# Which provider grades answers for llm_judge: anthropic | gemini
JUDGE_PROVIDER=anthropic

# Agent loop limits
AGENT_MAX_TURNS=8
# Questions run at the same time (use 1 on rate-limited free tiers)
MAX_CONCURRENCY=5

# Where evaluation run reports are written
RESULTS_DIR=results
