# Copy to .env and fill in values. Never commit .env.
APP_NAME=agentic-ai-evaluation
APP_ENV=development
LOG_LEVEL=INFO

# Anthropic (Claude) API
ANTHROPIC_API_KEY=sk-ant-...
# Model used by the agent under test
AGENT_MODEL=claude-opus-5-5
# Model used as the LLM judge
JUDGE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AGENT_EFFORT=medium
JUDGE_EFFORT=medium
# Retry refused requests on a fallback model automatically (server-side)
ENABLE_FALLBACKS=true

# Agent loop limits
AGENT_MAX_TURNS=8

# Where evaluation run reports are written
RESULTS_DIR=results
